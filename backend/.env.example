# Application
APP_NAME="ML Platform"
APP_VERSION="1.0.0"
DEBUG=false

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# Local dev (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./ml_platform.db
# Production (PostgreSQL via Neon, Supabase, or self-hosted):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/ml_platform

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# File storage directories (relative to backend/)
UPLOAD_DIR=uploadfiles
MODELS_DIR=trained_models
PREDICT_DIR=predictfiles
RESULTS_DIR=predictresults
